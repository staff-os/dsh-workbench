{
  "name": "@staff-os/dsh-workbench",
  "description": "Enterprise workbench capabilities for the DeepSeek Harness — AI employees, knowledge bases, skills, MCP servers and plugins, all managed from local state",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staff-os/dsh-workbench.git"
  },
  "homepage": "https://github.com/staff-os/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/staff-os/dsh-workbench/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "clsx": "^2.1.1",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "rm -rf lib .tsbuild",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.8",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.3",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
